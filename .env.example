# AWS Cloud Configuration for Bank Management System
# Copy this file to .env and fill in your actual values

# LDAP Authentication (AWS Directory Service)
LDAP_SERVER=ad.example.com
LDAP_USER=serviceaccount
LDAP_BASE_DN=DC=example,DC=com

# Database Connection (Amazon RDS)
DATABASE_CONNECTION_STRING=Server=mydb.rds.amazonaws.com;Database=BankDB;User Id=admin;Password=REPLACE_WITH_SECRET;

# Amazon SQS Queue URLs
SQS_TRANSFER_AUDIT_QUEUE_URL=https://sqs.us-east-1.amazonaws.com/123456789012/transfer-audit
SQS_CUSTOMER_INFO_QUEUE_URL=https://sqs.us-east-1.amazonaws.com/123456789012/customer-info

# Amazon S3 Bucket Names
S3_CUSTOMER_LOGS_BUCKET=bank-customer-logs
S3_DEPOSIT_CACHE_BUCKET=bank-deposit-cache

# Logging Configuration
AUDIT_LOG_PATH=/var/log/bankapp/audit

# AWS Region (optional, defaults to SDK configuration)
AWS_REGION=us-east-1

# AWS Credentials (optional, use IAM roles in production)
# AWS_ACCESS_KEY_ID=your-access-key
# AWS_SECRET_ACCESS_KEY=your-secret-key

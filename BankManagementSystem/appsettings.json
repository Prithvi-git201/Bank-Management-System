{
  "ConnectionStrings": {
    "DefaultConnection": "Server=${DATABASE_SERVER};Database=${DATABASE_NAME};User Id=${DATABASE_USER};Password=${DATABASE_PASSWORD};"
  },
  "AWS": {
    "Region": "us-east-1",
    "S3": {
      "CustomerLogsBucket": "${S3_CUSTOMER_LOGS_BUCKET}",
      "DepositCacheBucket": "${S3_DEPOSIT_CACHE_BUCKET}"
    },
    "SQS": {
      "TransferAuditQueueUrl": "${SQS_TRANSFER_AUDIT_QUEUE_URL}",
      "CustomerInfoQueueUrl": "${SQS_CUSTOMER_INFO_QUEUE_URL}"
    },
    "LDAP": {
      "Server": "${LDAP_SERVER}",
      "BaseDN": "${LDAP_BASE_DN}"
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning"
    }
  },
  "Paths": {
    "AuditLogPath": "${AUDIT_LOG_PATH}"
  }
}
